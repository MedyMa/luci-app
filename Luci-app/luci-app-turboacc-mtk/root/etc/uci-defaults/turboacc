#!/bin/sh


kernel_ver="$(uname -r)"

has_module_file() {
	local module

	for module in "$@"; do
		set -- "/lib/modules/$kernel_ver/$module.ko"*
		[ -e "$1" ] && return 0
	done

	return 1
}

# Initialize absent options only; package upgrades must retain user settings.
set_default() {
	uci -q get "$1" >/dev/null 2>&1 || uci -q set "$1=$2"
}

uci -q get turboacc.config >/dev/null 2>&1 || uci -q set turboacc.config=turboacc

if has_module_file "mtkhnat" "mediatek_hnat" ||
   [ -d /sys/module/mtkhnat ] || [ -d /sys/module/mediatek_hnat ] ||
   [ -d /sys/kernel/debug/hnat ]; then
	set_default "turboacc.config.fastpath" "mediatek_hnat"
	set_default "turboacc.config.fastpath_mh_eth_hnat" "1"
	set_default "turboacc.config.fastpath_mh_eth_hnat_v6" "1"
	set_default "turboacc.config.fastpath_mh_eth_hnat_bind_rate" "30"
elif has_module_file "fast-classifier"; then
	set_default "turboacc.config.fastpath" "fast_classifier"
	set_default "turboacc.config.fastpath_fc_br" "1"
	if [ -d "/proc/sys/net/ipv6" ]; then
		set_default "turboacc.config.fastpath_fc_ipv6" "1"
	else
		set_default "turboacc.config.fastpath_fc_ipv6" "0"
	fi
elif has_module_file "shortcut-fe-cm"; then
	set_default "turboacc.config.fastpath" "shortcut_fe_cm"
else
	set_default "turboacc.config.fastpath" "none"
fi

if has_module_file "xt_FULLCONENAT"; then
	set_default "turboacc.config.fullcone" "1"
else
	set_default "turboacc.config.fullcone" "2"
fi

uci -q commit "turboacc" || exit 1

uci -q batch <<-EOF >/dev/null
	delete ucitrack.@turboacc[-1]
	add ucitrack turboacc
	set ucitrack.@turboacc[-1].init='turboacc'
	set ucitrack.@turboacc[-1].config='turboacc'
EOF

uci -q commit "ucitrack" || exit 1

rm -f /tmp/luci-indexcache
exit 0

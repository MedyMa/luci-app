msgid "0 stops the fan; 100 uses maximum PWM."
msgstr "0 停转，100 输出最高 PWM。"

msgid "Basic settings"
msgstr "基本设置"

msgid "CPU temperature"
msgstr "CPU 温度"

msgid "Control interval (seconds)"
msgstr "控制间隔（秒）"

msgid "Control mode"
msgstr "控制模式"

msgid "Device unavailable"
msgstr "设备信息未获取"

msgid "Disabled"
msgstr "已停用"

msgid "Enable service"
msgstr "启用服务"

msgid "Estimated from PWM · illustrative rotation"
msgstr "按 PWM 估算 · 动画仅示意"

msgid "Fan Control"
msgstr "风扇控制"

msgid "Fan control unavailable."
msgstr "风扇控制不可用。"

msgid "Five seconds is recommended."
msgstr "建议保持 5 秒。"

msgid "Fixed PWM output"
msgstr "固定 PWM 输出"

msgid "Follow temperature"
msgstr "随温度自动调速"

msgid "Full-speed temperature (°C)"
msgstr "满速温度（°C）"

msgid "Manual"
msgstr "手动"

msgid "Manual PWM (%)"
msgstr "手动 PWM（%）"

msgid "Manual and Turbo modes require a writable PWM fan interface."
msgstr "此设备不支持手动和狂暴模式，请使用智能模式。"

msgid "Maximum PWM output"
msgstr "持续满速散热"

msgid "Maximum speed (RPM)"
msgstr "最大转速（RPM）"

msgid "Measured speed · illustrative rotation"
msgstr "实测转速 · 动画仅示意"

msgid "Mode unavailable"
msgstr "模式不可用"

msgid "No compatible fan control was detected."
msgstr "未检测到兼容的温度传感器或风扇控制接口。"

msgid "PWM duty"
msgstr "PWM 占空比"

msgid "Refresh every %s seconds"
msgstr "每 %s 秒刷新"

msgid "Running"
msgstr "运行中"

msgid "Running mode"
msgstr "运行模式"

msgid "Service is enabled but not running."
msgstr "服务已启用，但尚未运行。"

msgid "Smart"
msgstr "智能"

msgid "Speed display and estimation ceiling."
msgstr "用于匹配风扇的显示与估算上限。"

msgid "Speed unavailable"
msgstr "转速未获取"

msgid "Status unavailable"
msgstr "状态获取失败"

msgid "Stop temperature (°C)"
msgstr "停转温度（°C）"

msgid "Stop temperature must be lower than full-speed temperature."
msgstr "停转温度必须低于满速温度。"

msgid "Stop the fan below this temperature."
msgstr "低于此温度时停止风扇。"

msgid "Stopped"
msgstr "已停止"

msgid "Turbo"
msgstr "狂暴"

msgid "Unable to read fan status. Retrying automatically."
msgstr "无法读取风扇状态，正在自动重试。"

msgid "Unavailable"
msgstr "不可用"

msgid "Unsupported device"
msgstr "设备不支持"

msgid "Use maximum PWM at this temperature."
msgstr "达到此温度时输出最高 PWM。"

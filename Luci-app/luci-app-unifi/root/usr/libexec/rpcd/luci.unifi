#!/usr/bin/python3 -B
"""LuCI RPC boundary. Only return fields intended for the management page."""
import json
import re
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, "/usr/lib/be14-ucg")
from agent import (AgentBusy, DEFAULT_VERSION, FACTORY_KEY, LAST_INFORM, MODEL, STATE, binding_signature, endpoint,
                   firmware_version, local, locked, run, state_for)
from telemetry import wireless_report
from wired import controller_bridge_error, wired_uplink
from wired_host import status as wired_host_status
from wlan import valid_wlan_id

METHODS = {"status": {}, "configure": {"previous": "", "settings": ""},
           "set_model": {"mac": "", "previous": "", "model": ""}}
FLAGS = ("enabled", "wired_host", "auto_provision")
OPTIONS = ("inform_url", "management_network", "firmware_version", "wlan_id")
INIT = "/etc/init.d/be14-ucg"


def ubus(obj, method, args=None):
    return json.loads(run(["/bin/ubus", "call", obj, method, json.dumps(args or {})]))


def settings():
    raw = ubus("uci", "get", {"config": "be14_ucg", "section": "main"})["values"]
    values = {key: raw.get(key, "") for key in OPTIONS}
    values.update({key: raw.get(key) == "1" for key in FLAGS})
    sections = raw.get("section", [])
    values["sections"] = sorted([sections] if isinstance(sections, str) else sections)
    return values


def networks():
    return sorted({row["interface"] for row in ubus("network.interface", "dump").get("interface", [])
                   if re.fullmatch(r"[A-Za-z0-9_]+", row.get("interface", ""))})


def station_mode(row):
    for field, generation in (("is_11be", 7), ("is_11ax", 6), ("is_11ac", 5), ("is_11n", 4)):
        if row.get(field):
            return generation


def status():
    cfg = settings()
    board = ubus("system", "board")
    svc = ubus("service", "list", {"name": "be14-ucg"}).get("be14-ucg", {})
    out = dict(settings=cfg, networks=networks(), model=MODEL, default_version=DEFAULT_VERSION,
               board=board.get("model"), hostname=board.get("hostname"), system=(board.get("release") or {}).get("description"),
               running=any(i.get("running") for name, i in svc.get("instances", {}).items() if name != "wired_host"),
               wired_host=wired_host_status() if cfg["enabled"] and cfg["wired_host"] else {},
               paired=False, settings_received=False, radios=[], clients=[], candidates=[],
               controller_wlans=[], slots=[], upstream_ready=False, provisioned=False)
    if cfg["enabled"] and cfg["wired_host"] and not out["wired_host"]:
        worker = svc.get("instances", {}).get("wired_host", {})
        out["wired_host"] = {"state": "starting" if worker.get("running") else "stopped"}
    try:
        state = state_for(cfg["inform_url"]) if cfg["inform_url"] else {}
    except (OSError, KeyError, ValueError):
        state = {}
        out["state_error"] = True
    out["paired"] = state.get("key") not in (None, FACTORY_KEY)
    out["settings_received"] = state.get("wlan_model") == MODEL
    if out["paired"] and out["settings_received"]:
        out["controller_wlans"] = state.get("automatic_wlans", [])
    try:
        snap = local("overview")
        data = wireless_report(snap, state.get("report_wlans", {}))
    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
        out["radio_error"] = True
        return out
    out.update(uplink=wired_uplink(snap), management_device=snap.get("management_device"),
               ip=snap.get("ip"), mac=snap.get("mac"), total=data.get("num_sta"), candidates=snap.get("candidates") or [])
    out["slots"] = snap.get("slots") or []
    out["upstream_error"] = controller_bridge_error(snap)
    out["upstream_ready"] = out["upstream_error"] is None
    out["upstream_conflicts"] = snap.get("upstream_conflicts") or []
    out["controller_wlans"] = [dict(w, in_use=w["ssid"] in snap["other_ssids"]) for w in out["controller_wlans"]]
    inactive = state.get("inactive_bands", [])
    out["provisioned"] = bool(cfg["auto_provision"] and snap["bindings"] and not snap.get("missing_selection") and
                              state.get("applied_binding") == binding_signature(snap) and "pending" not in state and
                              all((not b.get("observed") and (b.get("missing") or b.get("disabled") == "1")) if band in inactive
                                  else b.get("bridge_attached") and b.get("observed") == b.get("ssid") and
                                  b.get("be14_ucg_managed") == "1" for band, b in snap["bindings"].items()))
    out["restricted_bands"] = state.get("restricted_bands", []) if out["provisioned"] else []
    out["withdrawn"] = out["provisioned"] and not out["restricted_bands"] and set(inactive) == set(snap["bindings"])
    try:
        url, mac, version, stamp = json.loads(LAST_INFORM.read_text())
        if out["paired"] and url == cfg["inform_url"] and mac == out["mac"]:
            out.update(last_inform=stamp, inform_age=max(0, int(time.time()) - stamp), last_version=version)
    except (OSError, TypeError, ValueError):
        pass
    configured_widths = {r["radio"]: r.get("ht") for r in data["radio_table"]}
    for radio in data["radio_table_stats"]:
        band = radio["radio"]
        live = snap["radios"][band]
        row = dict(band=band, up=radio["up"], ifname=live.get("ifname"), channel=radio.get("channel"),
                   configured=live.get("applied_htmode"), configured_width=configured_widths.get(band),
                   width=radio.get("bw"), clients=radio.get("num_sta"), aps=[])
        for ap in data["vap_table"]:
            if ap["radio"] != band:
                continue
            row["aps"].append(dict(ifname=ap["name"], ssid=ap["essid"], bssid=ap.get("bssid"),
                                   matched=bool(ap.get("id")), clients=ap.get("num_sta"),
                                   rx=ap.get("rx_bytes"), tx=ap.get("tx_bytes")))
            local_ap = next(bss for bss in snap["aps"] if bss["name"] == ap["name"])
            for sta in local_ap.get("sta_table", []):
                out["clients"].append(dict(mac=sta["mac"], name=sta.get("hostname"), model=sta.get("device_name"),
                    model_source=sta.get("model_source"),
                    ip=sta.get("ip"), ipv6=sta.get("ipv6") or [], wifi=station_mode(sta), signal=sta.get("signal"),
                    rx_rate=sta.get("rx_rate"), tx_rate=sta.get("tx_rate"),
                    rx=sta.get("rx_bytes"), tx=sta.get("tx_bytes"), band=band, ssid=ap["essid"], ifname=ap["name"]))
        out["radios"].append(row)
    return out


def check(cfg, before):
    if set(cfg) != set(before) or any(type(cfg[k]) is not bool for k in FLAGS):
        return {"error": "settings"}
    if any(not isinstance(cfg[k], str) or len(cfg[k]) > 250 for k in OPTIONS):
        return {"error": "settings"}
    url = cfg["inform_url"]
    if cfg["enabled"] or url:
        try:
            target = endpoint(url)
            if target.port == 0 or any(c.isspace() for c in url):
                return {"error": "url"}
        except (TypeError, ValueError):
            return {"error": "url"}
    try:
        firmware_version(cfg["firmware_version"])
    except ValueError:
        return {"error": "version"}
    network_changed = cfg["management_network"] != before["management_network"]
    if network_changed and cfg["management_network"] not in networks():
        return {"error": "network"}
    if STATE.exists() and url != before["inform_url"]:
        try:
            state_for(url)
        except (OSError, ValueError, KeyError):
            return {"error": "paired_url"}
    selected, wid = cfg["sections"], cfg["wlan_id"]
    automatic = cfg["auto_provision"]
    pattern = r"[A-Za-z0-9_]+" if automatic else r"be14_ucg_[A-Za-z0-9_]+"
    if (not isinstance(selected, list) or len(selected) > 3 or
        any(not isinstance(s, str) or not re.fullmatch(pattern, s) for s in selected)):
        return {"error": "binding"}
    if (selected != before["sections"] or wid != before["wlan_id"] or automatic != before["auto_provision"]
            or (automatic and (network_changed or (cfg["enabled"] and not before["enabled"])))):
        if bool(wid) != bool(selected) or (wid and not valid_wlan_id(wid)):
            return {"error": "binding"}
        if automatic:
            if not cfg["enabled"] or not selected:
                return {"error": "binding"}
            state = state_for(url)
            if state.get("wlan_model") != MODEL or state["key"] == FACTORY_KEY:
                return {"error": "controller_wlan"}
            snap = local("overview", network=cfg["management_network"], stations=False)
            snap["url"] = url
            issue = controller_bridge_error(snap)
            if issue:
                if issue == "upstream_dhcp" and snap.get("upstream_conflicts"):
                    return {"error": issue, "upstream_conflicts": snap["upstream_conflicts"]}
                return {"error": issue}
            if network_changed and (not snap.get("mac") or snap["mac"] != local("overview", stations=False).get("mac")):
                return {"error": "upstream_identity"}
            slots = {s["section"]: s["band"] for s in snap["slots"]} if snap["slots"] else {}
            bands = {slots.get(s) for s in selected}
            if None in bands or len(bands) != len(selected):
                return {"error": "slot"}
            if not any(w["id"] == wid and bands <= set(w["bands"]) and w["ssid"] not in snap["other_ssids"]
                       for w in state.get("automatic_wlans", [])):
                return {"error": "controller_wlan"}
            return None
        if selected:
            available = {s["section"]: s["band"] for s in local("overview", stations=False).get("candidates", [])}
            if not all(s in available for s in selected) or len({available[s] for s in selected}) != len(selected):
                return {"error": "binding"}
    return None


def configure(args):
    change = json.loads(args["settings"])
    with locked(blocking=False):
        old = settings()
        previous = json.loads(args["previous"])
        if (old != previous and old != change) or run(["/sbin/uci", "-q", "changes", "be14_ucg"]).strip():
            return {"error": "conflict"}
        error = check(change, old)
        if error:
            return error
        with tempfile.TemporaryDirectory(prefix="unifi-settings-") as delta:
            def uci(*cmd):
                run(["/sbin/uci", "-t", delta, *cmd])
            for key in OPTIONS + FLAGS:
                if change[key] != old[key]:
                    value = str(int(change[key])) if key in FLAGS else change[key]
                    uci("set", "be14_ucg.main." + key + "=" + value)
            if old["sections"] != change["sections"]:
                if old["sections"]:
                    uci("delete", "be14_ucg.main.section")
                for section in change["sections"]:
                    uci("add_list", "be14_ucg.main.section=" + section)
            if change != old:
                uci("commit", "be14_ucg")
    # procd reconciles instances from the current UCI config, even if a later save won the race.
    try:
        run([INIT, "enable"])
        run([INIT, "reload"])
    except (OSError, subprocess.SubprocessError):
        return {"error": "service", "saved": True}
    return {"saved": True}


def set_model(args):
    mac, value = args["mac"], args["model"].strip()
    if (not re.fullmatch(r"(?:[0-9a-f]{2}:){5}[0-9a-f]{2}", mac) or mac == "00:00:00:00:00:00"
            or int(mac[:2], 16) & 1 or len(value.encode()) > 96 or
            any(not c.isprintable() or c in "<>" for c in value)):
        return {"error": "model"}
    name = "be14_ucg.client_" + mac.replace(":", "")
    with locked(blocking=False), tempfile.TemporaryDirectory(prefix="unifi-model-") as delta:
        if run(["/sbin/uci", "-q", "changes", "be14_ucg"]).strip():
            return {"error": "conflict"}
        rows = (s for ap in local("overview")["aps"] for s in ap.get("sta_table", []))
        station = next((s for s in rows if s["mac"] == mac), None)
        if not station:
            return {"error": "disconnected"}
        previous = station["device_name"] if station.get("model_source") == "manual" else ""
        if previous != args["previous"] and previous != value:
            return {"error": "conflict"}
        if previous != value:
            cmd = ["/sbin/uci", "-t", delta]
            if value:
                run(cmd + ["set", name + "=client"])
                run(cmd + ["set", name + ".model=" + value])
            else:
                run(cmd + ["delete", name + ".model"])
            run(cmd + ["commit", "be14_ucg"])
    return {"saved": True}


if __name__ == "__main__":
    if sys.argv[1:] == ["list"]:
        print(json.dumps(METHODS))
    elif len(sys.argv) == 3 and sys.argv[1] == "call" and sys.argv[2] in METHODS:
        try:
            request = json.load(sys.stdin)
            if sys.argv[2] == "status":
                result = status()
            elif sys.argv[2] == "set_model":
                result = set_model(request)
            else:
                result = configure(request)
        except AgentBusy:
            result = {"error": "busy"}
        except (KeyError, TypeError, ValueError, OSError, subprocess.SubprocessError):
            result = {"error": "unavailable"}
        print(json.dumps(result, allow_nan=False))
    else:
        sys.exit(1)

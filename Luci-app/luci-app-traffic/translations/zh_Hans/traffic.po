# The generic one-word msgids ("Application", "Total", "Down", "Up", "Clients")
# are deliberately NOT used: luci-base translates those itself and its text wins
# at runtime ("Application" came out as "应用层", which means something else
# entirely).  Every string this page needs is therefore spelled out.
#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Application name"
msgstr "应用"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Total traffic"
msgstr "总量"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Received"
msgstr "下载"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Sent"
msgstr "上传"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Client count"
msgstr "客户端数"

# The strip box for the same figure uses its own word: sitting next to
# "客户端合计" (the bytes) a second "客户端数" reads as more of the same thing,
# where "设备数" is plainly a count of devices.  The table header keeps
# "客户端数", which is what its column actually holds.
#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Devices"
msgstr "设备数"

# The strip box that counts the applications the table is listing.  It is the
# same word the table's own column header uses ("Application name"), so the box
# and the column read as one thing, and "应用" rather than "应用数" because the
# caption is already the name of what is being counted - next to "设备数" and
# "周期" a second "数" suffix would read as more of the same.
#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Apps"
msgstr "应用"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "No samples yet"
msgstr "暂无采样数据"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "State"
msgstr "状态"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Running"
msgstr "运行中"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Running, no traffic measured yet"
msgstr "运行中，尚未统计到流量"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Collector has not produced a snapshot yet"
msgstr "采集器尚未生成快照"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Snapshot is stale"
msgstr "快照已过期"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Interval"
msgstr "间隔"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Flows"
msgstr "连接跟踪"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Host names"
msgstr "主机名"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Waiting to resolve"
msgstr "待解析"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Query log"
msgstr "查询日志"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Router addresses"
msgstr "路由器自身地址"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Counter total"
msgstr "计数器总量"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Accounted share"
msgstr "已分类占比"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "every packet counted at the LAN interface, proxied traffic included"
msgstr "在 LAN 接口处逐包计数，包含被代理的流量"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Client totals"
msgstr "总量来源"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "nft counters"
msgstr "nft 计数器"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "conntrack"
msgstr "连接跟踪"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Counter error"
msgstr "计数器错误"

# The warning that the nft counters are being used on a router whose firewall
# offloads forwarded traffic past them - the combination that undercounts.
#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Counter mode"
msgstr "计数口径"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "flow offloading is on: the nft counters miss client traffic"
msgstr "已开启流量卸载：nft 计数会漏掉客户端流量"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Collector version"
msgstr "版本"

# The hour the collector is currently accumulating.  It was labelled "Bucket",
# which is also the caption of the archived-hour count in the same strip - two
# different readings under one word once the strips were merged into one row.
#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Current hour"
msgstr "当前小时"

# Small-case variants: "Total"/"Up" are translated by luci-base, so the page
# uses its own caption strings where the wording has to be exact.
#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "total"
msgstr "总计"

# What the ring is a breakdown of.  The hero already says 总计 for the same
# number; the ring's own label says what the slices add up to.
#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Total volume"
msgstr "总流量"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "up"
msgstr "上行"

# --- 0.1.90: 接口计数器成为权威总量 -----------------------------------------
# 「总计/下载/上传」现在优先取 /proc/net/dev 的接口计数（summary.iface），它不受
# 流卸载影响；归属值（应用/客户端明细之和）只作为占比呈现，因此不能再自称「总计」。
#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Attributed"
msgstr "已归属"

# 已归属占比的说明：路由器实际承载的流量里，应用与客户端归属能说出名字的部分。
#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "share of the traffic the router carried that the app and client accounting could name"
msgstr "在路由器实际承载的流量中，应用与客户端归属能说出名字的部分所占比例"

# 会话视图的卸载告警：这里的总量来自接口计数（准确），明细只是其中一部分。
#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "flow offloading is on: the app breakdown only accounts for part of the traffic, while the totals above come from the interface counters and are exact"
msgstr "已开启流量卸载：应用明细只覆盖了其中一部分流量，上方总计来自接口计数器，是准确的"

# 范围视图的卸载告警：归档小时来自归属层，没有对应的接口总量，所以不能说「总量准确」。
#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "flow offloading is on: the accounting layer only sees part of the forwarded traffic, so the figures below are a share of what the box carried"
msgstr "已开启流量卸载：记账层只能看到转发流量的一部分，下方数字只是实际承载量的一份占比"

# 协议桶（SSL/TLS、QUIC、HTTP、DNS、STUN 等）不是应用，单独成块列出。
#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Protocols (not applications)"
msgstr "协议（非应用）"

# 环形图右侧那份清单是「已归属流量」的构成（协议桶也在其中），不能沿用表头那份
# 「应用」文案，否则 SSL/TLS 又会被读成一个应用。
#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Attributed traffic"
msgstr "已归属流量"

# 热门客户端是本次运行的累计值，而旁边的字节列可能只覆盖所选范围，两个窗口不同。
#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Top client (this session)"
msgstr "热门客户端（本次运行）"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "the busiest client of each application is recorded for the current run, while the byte columns can cover the selected range"
msgstr "每个应用的热门客户端记录的是本次运行的累计值，而字节列可能只覆盖所选时间范围，两者不是同一个统计窗口"

# 合计行的热门客户端属于该行自己的窗口：会话视图看本次运行，范围视图看归档的客户端行。
#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "the busiest client overall, for the current run"
msgstr "整体最忙的客户端，统计自本次运行"

#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "the busiest client of the selected range, from the archived client rows"
msgstr "所选时间范围内最忙的客户端，取自归档的客户端记录"

#: htdocs/luci-static/resources/view/traffic/overview.js
# 环形图里其余应用的合计切片：环现在代表总计，图例也把它和未归属一起列出
msgid "Other apps"
msgstr "其余应用"

# --- 环形图代表总计，不再是已归属 ---------------------------------------------
# 环里「没能归属」的那一段：本窗口的总量减去应用/客户端归属能说出名字的部分。
# 开流卸载或走代理隧道时它很大（实测占 62%），所以它必须有一眼可辨的颜色：中性
# 灰，而不是调色板里的应用色——没有任何东西被识别出来，它不该看起来像一个应用。
#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Unattributed"
msgstr "未归属"

# 环形图右侧那份清单的标题。环现在画的是整个窗口的构成（前十名 + 其余应用 +
# 未归属），其 100% 就是上方总计，所以它不再是「已归属流量」的构成。
#: htdocs/luci-static/resources/view/traffic/overview.js
msgid "Traffic breakdown"
msgstr "流量构成"

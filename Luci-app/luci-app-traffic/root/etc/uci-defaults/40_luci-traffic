#!/bin/sh
# First-install defaults for luci-app-traffic.

[ -f /etc/config/traffic ] || exit 0

# The collector needs somewhere to keep the hourly history.  This is on the
# writable root (the overlay), so it survives a reboot but not a sysupgrade
# unless the user keeps it.
mkdir -p /etc/traffic

# Fill in the AdGuard Home querylog path once, so the settings page shows the
# path actually in use instead of an empty field.
if [ -z "$(uci -q get traffic.settings.querylog)" ]; then
	wl=$(uci -q get AdGuardHome.AdGuardHome.workdir)
	[ -n "$wl" ] || wl='/etc/config/adGuardConfig/workspace'
	uci -q set traffic.settings.querylog="$wl/data/querylog.json"
fi

# 0.1.46 raised the shipped ceiling on how many applications are published and
# drawn from 50 to 300.  /etc/config/traffic is a conffile, so an upgrade keeps
# whatever the router already had and a fresh default would never reach an
# existing install.  Only the exact old default is moved: a value somebody
# picked on purpose is left alone.
if [ "$(uci -q get traffic.settings.top_apps)" = "50" ]; then
	uci -q set traffic.settings.top_apps='300'
fi

uci -q commit traffic

# A procd service is not started, and not even enabled, by being installed.
# Without the enable the collector would not come up after the reboot either,
# because the boot sequence only starts what has an /etc/rc.d symlink.  The
# result is a page that reports "no snapshot yet" forever.
[ -x /etc/init.d/traffic ] && /etc/init.d/traffic enable >/dev/null 2>&1

exit 0

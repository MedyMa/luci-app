{
	"luci-app-traffic": {
		"description": "Grant access to the per-application traffic statistics",
		"read": {
			"uci": [ "traffic" ],
			"ubus": {
				"luci.traffic": [ "getSummary", "getHourly", "getConfig", "getSeries", "resolveNow", "getLive" ]
			}
		},
		"write": {
			"uci": [ "traffic" ],
			"ubus": {
				"luci.traffic": [ "resetStats" ]
			}
		}
	}
}

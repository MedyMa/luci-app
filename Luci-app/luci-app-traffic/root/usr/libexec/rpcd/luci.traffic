#!/bin/sh
# rpcd backend for luci-app-traffic.
#
# The collector already writes everything the UI needs into
# /tmp/traffic/summary.json, so this backend stays thin: it re-emits that
# snapshot (which also validates it, because jshn has to parse it), aggregates
# the hourly history on demand, and exposes the effective settings.

. /usr/share/libubox/jshn.sh

STATE_DIR=${STATE_DIR:-/tmp/traffic}

datadir() {
	local d
	d=$(uci -q get traffic.settings.datadir 2>/dev/null)
	[ -n "$d" ] || d=/etc/traffic
	printf '%s\n' "$d"
}

interval() {
	local i
	i=$(uci -q get traffic.settings.interval 2>/dev/null)
	case "$i" in ''|*[!0-9]*) i=10 ;; esac
	[ "$i" -lt 2 ] && i=2
	printf '%s\n' "$i"
}

empty_summary() {
	# Same shape as the collector's snapshot, so the page reads one schema
	# whether the collector has produced anything yet or not.  acct is 0 here
	# because no counters can be running before the first round; version is
	# empty because this script does not know which build is installed.
	printf '{"collected_at":0,"interval":0,"hour":"","flows":0,"dnsmap_lines":0,"pending":0,"rounds":0,'
	printf '"version":"","acct":0,'
	printf '"querylog":"","apps":[],"clients":[],'
	printf '"totals":{"down":0,"up":0,"other":0,"router":0,"client_count":0,'
	printf '"exact":0,"any":0,"bucket":0,"residual":0}}\n'
}

# Re-emit the snapshot for the page.
#
# The collector writes it with write-to-temp-then-rename, so a reader never sees
# a half-written file and passing the bytes straight through is safe.  Parsing
# it with jshn and serialising it again - which is what this used to do - costs
# a process and a full shell-side parse on every poll of every open page, to
# validate a file we wrote ourselves.
get_summary() {
	local f="$STATE_DIR/summary.json"
	if [ -s "$f" ] && [ "$(head -c 1 "$f" 2>/dev/null)" = "{" ]; then
		cat "$f"
	else
		empty_summary
	fi
}

# Ask the collector to stop waiting out its resolve_interval and name the
# host names it has seen since the last pass.  Called by the page while it is
# open, so the cost is only paid when somebody is looking at the result.
resolve_now() {
	: > "$STATE_DIR/resolve.now"
	json_init
	json_add_boolean result 1
	json_dump
}

# Aggregate hourly.tsv into per-hour application totals.
#   hourly.tsv: <hour>\t<app|client|router>\t<name>\t<down>\t<up>
#
# One pass over the file, not one pipeline per hour.  The previous shape forked a
# sort and two awks for each of the three row kinds of every hour, so the day view
# the page opens on cost roughly 170 processes and 170 full scans of the file -
# and the page asks for it every five seconds, which is what made the list take
# seconds to fill in.  Every row of an hour is still returned, not the biggest
# few: the page sums the hours up to build 12h/24h/7d, so a truncated list would
# leave the tail of each hour out of that total.  Row order within an hour does
# not matter, because the page sorts by bytes itself.
get_hourly() {
	local hours="$1" f list sel
	case "$hours" in ''|*[!0-9]*) hours=24 ;; esac
	f="$(datadir)/hourly.tsv"
	if [ ! -s "$f" ]; then
		printf '{"hours":[]}\n'
		return
	fi
	list=$(awk -F'\t' '{ if (!seen[$1]++) print $1 }' "$f" | sort | tail -n "$hours")
	sel=$(printf '%s ' $list)
	awk -F'\t' -v sel="$sel" '
		# Names come from the generated catalogue, so a quote is the only thing
		# that could break the JSON; the & form is what makes gsub put a real
		# backslash in front of the match instead of eating it.
		function esc(s) { gsub(/\\/, "\\\\&", s); gsub(/"/, "\\&", s); return s }
		BEGIN {
			n = split(sel, w, " ")
			for (i = 1; i <= n; i++) { order[i] = w[i]; keep[w[i]] = 1 }
		}
		!($1 in keep) { next }
		$2 == "app" {
			k = $1 SUBSEP $3
			if (!(k in seen_a)) { seen_a[k] = 1; names_a[$1] = names_a[$1] $3 "\n" }
			ad[k] += $4 + 0; au[k] += $5 + 0
			next
		}
		$2 == "client" {
			k = $1 SUBSEP $3
			if (!(k in seen_c)) { seen_c[k] = 1; names_c[$1] = names_c[$1] $3 "\n" }
			cb[k] += $4 + 0
			next
		}
		$2 == "router" { rv[$1] += $4 + 0; next }
		END {
			printf "{\"hours\":["
			for (i = 1; i <= n; i++) {
				h = order[i]
				if (i > 1) printf ","
				printf "{\"hour\":\"%s\",\"apps\":[", esc(h)
				na = split(names_a[h], nm, "\n")
				f1 = 1
				for (j = 1; j <= na; j++) {
					if (nm[j] == "") continue
					k = h SUBSEP nm[j]
					if (!f1) printf ","
					f1 = 0
					printf "{\"name\":\"%s\",\"down\":%d,\"up\":%d}", esc(nm[j]), ad[k], au[k]
				}
				printf "],\"clients\":["
				ncl = split(names_c[h], cn, "\n")
				f2 = 1
				for (j = 1; j <= ncl; j++) {
					if (cn[j] == "") continue
					k = h SUBSEP cn[j]
					if (!f2) printf ","
					f2 = 0
					printf "{\"ip\":\"%s\",\"bytes\":%d}", esc(cn[j]), cb[k]
				}
				printf "],\"router\":%d}", rv[h] + 0
			}
			printf "]}\n"
		}
	' "$f"
}

get_config() {
	json_init
	json_add_boolean enabled "$(uci -q get traffic.settings.enabled)"
	json_add_string interval "$(uci -q get traffic.settings.interval)"
	json_add_string datadir "$(datadir)"
	json_add_string querylog "$(uci -q get traffic.settings.querylog)"
	json_add_string lan4 "$(uci -q get traffic.settings.lan4)"
	json_add_string lan6 "$(uci -q get traffic.settings.lan6)"
	json_add_string appmap "$(uci -q get traffic.settings.appmap)"
	json_add_string retention_days "$(uci -q get traffic.settings.retention_days)"
	json_add_string top_apps "$(uci -q get traffic.settings.top_apps)"
	json_add_string top_clients "$(uci -q get traffic.settings.top_clients)"
	json_add_string resolve_interval "$(uci -q get traffic.settings.resolve_interval)"
	json_add_string dnsmap_max "$(uci -q get traffic.settings.dnsmap_max)"
	json_dump
}

# Throughput history, in the three tiers the collector maintains:
#   1h  - one point per sampling interval (10 s by default), sharp
#   12h - one point per minute, half of the day tier
#   24h - one point per minute, kept in the datadir so it survives a reboot
#   7d  - one point per hour, covering a week
# Each point is [epoch, down bytes, up bytes]; the page turns bytes into rates.
get_series() {
	local range="$1" f iv max
	case "$range" in
		7d|week|w)
			range=7d;  f="$(datadir)/series1h.tsv"; iv=3600; max=168 ;;
		24h|24|day)
			range=24h; f="$(datadir)/series60.tsv"; iv=60; max=1440 ;;
		12h|12)
			range=12h; f="$(datadir)/series60.tsv"; iv=60; max=720 ;;
		*)
			range=1h;  f="$STATE_DIR/series10.tsv"; iv=$(interval)
			max=$((3600 / iv)); [ "$max" -lt 10 ] && max=10 ;;
	esac

	printf '{"range":"%s","interval":%s,"points":[' "$range" "$iv"
	awk -F'\t' 'NF >= 3 && $1 != "" && $1 ~ /^[0-9]+$/ { print }' "$f" 2>/dev/null \
		| tail -n "$max" \
		| awk -F'\t' 'BEGIN { n = 0 } { if (n++) printf ","; printf "[%s,%s,%s]", $1, $2 + 0, $3 + 0 }'
	printf ']}\n'
}

reset_stats() {
	local what="$1"
	rm -f "$STATE_DIR/totals.tsv" "$STATE_DIR/clients.tsv" "$STATE_DIR/router.tsv" "$STATE_DIR/stat.tsv" \
	      "$STATE_DIR/ac.tsv"
	: > "$STATE_DIR/totals.tsv"
	: > "$STATE_DIR/clients.tsv"
	: > "$STATE_DIR/router.tsv"
	: > "$STATE_DIR/ac.tsv"
	# The per-host counters live in the kernel.  Dropping the accumulated copy
	# and the rule set (so the next round rebuilds it) is what makes a reset
	# actually start from zero; keeping the absolute baseline would instead
	# count every counter again from where it stands.
	rm -f "$STATE_DIR/acct.tsv" "$STATE_DIR/acct.abs" "$STATE_DIR/acct.hosts"
	printf '0\n0\n0\n' > "$STATE_DIR/stat.tsv"
	# the sharp tier belongs to the session, the coarse one to the history
	: > "$STATE_DIR/series10.tsv"
	printf '0\n0\n0\n' > "$STATE_DIR/minute.tsv"
	if [ "$what" = "history" ]; then
		rm -f "$(datadir)/hourly.tsv"
		: > "$(datadir)/series60.tsv"
	fi
	json_init
	json_add_boolean result 1
	json_dump
}

case "$1" in
	list)
		json_init
		json_add_object "getSummary"; json_close_object
		json_add_object "getHourly"
		json_add_string "hours" "integer"
		json_close_object
		json_add_object "getConfig"; json_close_object
		json_add_object "getSeries"
		json_add_string "range" "string"
		json_close_object
		json_add_object "resolveNow"; json_close_object
		json_add_object "resetStats"
		json_add_string "what" "string"
		json_close_object
		json_dump
		;;
	call)
		read -r input
		json_load "$input" 2>/dev/null
		json_get_var arg_hours hours
		json_get_var arg_what what
		json_get_var arg_range range
		# rpcd invokes a plugin as "<script> call <method>" and passes the
		# arguments as a JSON object on stdin, so the method is $2 - it is not
		# part of that object.  Reading it out of the stdin JSON instead (which
		# is what this did) matches nothing, because the caller only sends the
		# parameters, and every call then answers "unknown method" while looking
		# like a healthy object.
		case "$2" in
			getSummary) get_summary ;;
			getHourly)  get_hourly "$arg_hours" ;;
			getConfig)  get_config ;;
			getSeries)  get_series "$arg_range" ;;
			resolveNow) resolve_now ;;
			resetStats) reset_stats "$arg_what" ;;
			*) json_init; json_add_string "error" "unknown method" ; json_dump ;;
		esac
		;;
esac
